{% extends 'partials/base.html.twig' %}

{% block content %}
<div class="section" style="margin-top: 30px;">
    <h2 class="blog-heading">{{ page.title }}<span class="terminal-cursor"></span></h2>

    {% if page.content %}
    <div class="blog-intro">
        {{ page.content|raw }}
    </div>
    {% endif %}

    {# Use a defined collection if the page header sets one; otherwise fall back to published children. #}
    {% set collection = page.header.content.items is defined ? page.collection() : page.children.published.order('date', 'desc') %}
    {% if collection.count > 0 %}
    <div class="blog-grid">
        {% for child in collection %}
        <article class="blog-post-card">
            {% if child.media.images|first %}
            <div class="post-image">
                <a href="{{ child.url }}"><img src="{{ child.media.images|first.url }}" alt="{{ child.title }}"></a>
            </div>
            {% endif %}

            <div class="post-content">
                <h3 class="post-title"><a href="{{ child.url }}">{{ child.title }}</a></h3>

                <div class="post-meta">
                    <span class="post-date">&#128197; {{ child.date|date("Y-m-d") }}</span>
                    {% if child.taxonomy.tag %}
                    <span class="post-tags">
                        {% for tag in child.taxonomy.tag %}<span class="tag">{{ tag }}</span>{% endfor %}
                    </span>
                    {% endif %}
                </div>

                {% if child.summary %}
                <div class="post-summary">{{ child.summary|striptags|truncate(220, true, '...') }}</div>
                {% elseif child.content %}
                <div class="post-summary">{{ child.content|striptags|truncate(220, true, '...') }}</div>
                {% endif %}

                <a href="{{ child.url }}" class="read-more">READ MORE &#8594;</a>
            </div>
        </article>
        {% endfor %}
    </div>

    {% if collection.params.pagination is defined and collection.params.pagination %}
    <div class="pagination">
        {% if collection.params.pagination.prev_url %}
        <a href="{{ collection.params.pagination.prev_url }}" class="pagination-link">&#8592; PREV</a>
        {% endif %}
        <span class="pagination-info">Page {{ collection.params.pagination.current }} of {{ collection.params.pagination.total_pages }}</span>
        {% if collection.params.pagination.next_url %}
        <a href="{{ collection.params.pagination.next_url }}" class="pagination-link">NEXT &#8594;</a>
        {% endif %}
    </div>
    {% endif %}

    {% else %}
    <p style="color: var(--text-secondary); margin-top: 30px;">No posts yet.</p>
    {% endif %}
</div>

<style>
.blog-heading {
    color: var(--primary-green);
    text-transform: uppercase;
    letter-spacing: 3px;
}

.blog-intro {
    color: var(--text-secondary);
    margin: 20px 0;
    line-height: 1.8;
}

.blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 30px;
}

.blog-post-card {
    background: var(--bg-black);
    border: 1px solid var(--border-color);
    overflow: hidden;
    transition: all 0.3s;
}

.blog-post-card:hover {
    border-color: var(--primary-green);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 255, 65, 0.2);
}

.post-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: var(--bg-dark);
}

.post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
}

.blog-post-card:hover .post-image img {
    transform: scale(1.1);
}

.post-content {
    padding: 20px;
}

.post-title {
    font-size: 20px;
    margin-bottom: 15px;
}

.post-title a {
    color: var(--primary-green);
    text-decoration: none;
    transition: all 0.3s;
}

.post-title a:hover {
    text-shadow: 0 0 10px var(--primary-green);
}

.post-meta {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 15px;
    font-size: 12px;
    color: var(--text-secondary);
}

.post-tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
}

.tag {
    background: var(--bg-dark);
    border: 1px solid var(--border-color);
    padding: 2px 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.post-summary {
    color: var(--text-secondary);
    margin-bottom: 20px;
    line-height: 1.6;
}

.read-more {
    display: inline-block;
    color: var(--primary-green);
    text-decoration: none;
    border: 1px solid var(--primary-green);
    padding: 8px 20px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 12px;
    transition: all 0.3s;
}

.read-more:hover {
    background: var(--primary-green);
    color: var(--bg-black);
}

.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
    margin-top: 50px;
    padding: 30px;
    background: var(--bg-black);
    border: 1px solid var(--border-color);
}

.pagination-link {
    color: var(--primary-green);
    text-decoration: none;
    border: 1px solid var(--primary-green);
    padding: 10px 30px;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all 0.3s;
}

.pagination-link:hover {
    background: var(--primary-green);
    color: var(--bg-black);
}

.pagination-info {
    color: var(--text-secondary);
    letter-spacing: 2px;
}
</style>
{% endblock %}
